# Normalize line endings in the repo; force LF in the working copy for
# everything an on-device shell / KernelSU installer / chgd reads, because
# a stray CR makes Android sh choke ("sleep: Unknown suffix '\r'") and
# corrupts led.conf values on older parsers.
* text=auto
*.sh   text eol=lf
*.prop text eol=lf
*.conf text eol=lf
*.txt  text eol=lf
