#!/sbin/sh

#################
# Initialization
#################

umask 022

# Load utility functions first
OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

ui_print() {
  echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD 2>/dev/null || echo "$1"
}

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

##########################
# Environment detection
##########################

if [ -f /data/adb/magisk/util_functions.sh ]; then
  # Magisk
  . /data/adb/magisk/util_functions.sh
  [ $MAGISK_VER_CODE -lt 20400 ] && require_new_magisk
  install_module
  exit 0
fi

# KernelSU: its manager handles the zip itself and never runs this stub.
# Recovery without Magisk/KSU cannot install this module.
ui_print "- Unsupported environment"
exit 1
